# Konfigurasi Midtrans Sandbox
MIDTRANS_SERVER_KEY=SB-Mid-server-YOUR_SERVER_KEY_HERE
MIDTRANS_CLIENT_KEY=SB-Mid-client-YOUR_CLIENT_KEY_HERE
MIDTRANS_IS_PRODUCTION=false

# Kredensial Firebase Admin SDK
# Isi dengan string JSON Service Account yang di-encode Base64, ATAU path ke file serviceAccountKey.json lokal
FIREBASE_SERVICE_ACCOUNT=eyJuYW1lIjoicGxhY2Vob2xkZXIifQ==

# Konfigurasi Integrasi Platform SatuSehat (Kemenkes RI)
# Staging URL: https://api-satusehat-stg.dto.kemkes.go.id
# Dapatkan Client ID dan Client Secret dari Portal Pengembang SatuSehat (satusehat.kemkes.go.id/platform)
SATUSEHAT_BASE_URL=https://api-satusehat-stg.dto.kemkes.go.id
SATUSEHAT_CLIENT_ID=YOUR_SATUSEHAT_CLIENT_KEY
SATUSEHAT_CLIENT_SECRET=YOUR_SATUSEHAT_CLIENT_SECRET
SATUSEHAT_ORG_ID=YOUR_SATUSEHAT_ORGANIZATION_ID

# Port lokal untuk Express
PORT=3000

# CORS Allowed Origins (opsional, pisahkan dengan koma jika lebih dari satu)
PAYMENT_ALLOWED_ORIGINS=*
