rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    
    // ── Helper Functions ───────────────────────────────────────────────────
    function isSignedIn() {
      return request.auth != null;
    }

    function userDoc() {
      return firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data;
    }

    function isAdmin() {
      return isSignedIn() && (
        (request.auth.token != null && 'role' in request.auth.token && request.auth.token.role == 'admin') ||
        (firestore.exists(/databases/(default)/documents/users/$(request.auth.uid)) &&
         'role' in userDoc() &&
         userDoc().role == 'admin')
      );
    }

    // ── 1. Lampiran Konsultasi Dokter ──────────────────────────────────────
    // Path: consultations/{userId}/{consultationId}/{fileName}
    match /consultations/{userId}/{consultationId}/{fileName} {
      allow read: if isSignedIn() && request.auth.uid == userId;
      
      allow write: if isSignedIn() 
                   && request.auth.uid == userId
                   && request.resource.size < 5 * 1024 * 1024
                   && (request.resource.contentType.matches('image/.*') 
                       || request.resource.contentType == 'application/pdf');
    }

    // ── 2. Foto Profil Dokter ──────────────────────────────────────────────
    // Path: doctors/{doctorId}/profile.jpg
    match /doctors/{doctorId}/{fileName} {
      allow read: if isSignedIn();

      allow write: if isSignedIn()
                   && request.resource.size < 2 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
    }

    // ── 3. Cover Artikel Berita (Utama) ────────────────────────────────────
    // Path: berita_articles/{articleId}/{fileName}
    match /berita_articles/{articleId}/{fileName} {
      // Baca: hanya untuk pengguna yang login (tidak dibuka untuk publik penuh)
      allow read: if isSignedIn();

      // Unggah & Perbarui: hanya admin, ukuran < 2MB, format gambar
      allow create, update: if isAdmin()
                            && request.resource.size < 2 * 1024 * 1024
                            && request.resource.contentType.matches('image/.*');

      // Hapus: hanya admin saat mengganti atau menghapus gambar
      allow delete: if isAdmin();
    }

    // ── 4. Kompatibilitas Path Berita Lama ──────────────────────────────────
    // Path: berita/{articleId}/{fileName}
    match /berita/{articleId}/{fileName} {
      allow read: if isSignedIn();
      allow create, update: if isAdmin()
                            && request.resource.size < 2 * 1024 * 1024
                            && request.resource.contentType.matches('image/.*');
      allow delete: if isAdmin();
    }

    // ── 5. Gambar Ensiklopedia (Gastropedia) ────────────────────────────────
    // Path: gastropedia_images/{fileName}
    match /gastropedia_images/{fileName} {
      allow read: if isSignedIn();
      allow create, update: if isAdmin()
                            && request.resource.size < 2 * 1024 * 1024
                            && request.resource.contentType.matches('image/.*');
      allow delete: if isAdmin();
    }
  }
}
