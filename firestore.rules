rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // ── Helper Functions ───────────────────────────────────────────────────
    function isSignedIn() {
      return request.auth != null;
    }

    function userDoc() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }
 
    function isDoctor() {
      return isSignedIn() && 
             ('role' in userDoc()) && 
             (userDoc().role == 'doctor' || userDoc().role == 'dokter');
    }

    function myDoctorId() {
      return (isDoctor() && ('doctorId' in userDoc())) ? userDoc().doctorId :
             (isDoctor() && ('doctor_id' in userDoc())) ? userDoc().doctor_id : '';
    }

    function isDoctorForDoc(docData) {
      return isDoctor() && (
        (myDoctorId() != '' && ('doctorId' in docData) && docData.doctorId == myDoctorId()) ||
        (('doctorId' in docData) && docData.doctorId == request.auth.uid) ||
        (('doctorUid' in docData) && docData.doctorUid == request.auth.uid) ||
        (('doctorId' in docData) && docData.doctorId != '' &&
         exists(/databases/$(database)/documents/doctors/$(docData.doctorId)) &&
         ('uid' in get(/databases/$(database)/documents/doctors/$(docData.doctorId)).data) &&
         get(/databases/$(database)/documents/doctors/$(docData.doctorId)).data.uid == request.auth.uid)
      );
    }

    function isAdmin() {
      return isSignedIn() && 
             ('role' in userDoc()) && 
             userDoc().role == 'admin';
    }

    // Helper pemeriksaan batas retensi 60 hari (Revisi 10 Bagian D & E)
    function isOlderThan60Days(docData) {
      return ('lastMessageAt' in docData && docData.lastMessageAt != null && request.time > docData.lastMessageAt + duration.value(60, 'd')) ||
             (!('lastMessageAt' in docData) && 'completedAt' in docData && docData.completedAt != null && request.time > docData.completedAt + duration.value(60, 'd')) ||
             (!('lastMessageAt' in docData) && !('completedAt' in docData) && 'createdAt' in docData && docData.createdAt != null && request.time > docData.createdAt + duration.value(60, 'd'));
    }

    // ── 1. Users Collection & Sub-collections ──────────────────────────────
    // Path: /users/{userId}
    match /users/{userId} {
      // Pemilik akun bisa membaca data dirinya, dan admin dapat membaca profil untuk pemantauan penilaian
      allow read: if isSignedIn() && (request.auth.uid == userId || isAdmin());

      // Pembuatan user baru (register publik): role tidak boleh langsung di-set ke 'doctor' / 'dokter'
      allow create: if isSignedIn() && request.auth.uid == userId 
                    && (!('role' in request.resource.data) || request.resource.data.role == 'patient' || request.resource.data.role == 'pengguna')
                    && (!('doctorId' in request.resource.data));

      // Update profil: role dan doctorId TIDAK BOLEH diubah dari sisi klien (mencegah eskalasi hak akses)
      allow update: if isSignedIn() && request.auth.uid == userId
                    && (!('role' in request.resource.data) || request.resource.data.role == resource.data.role)
                    && (!('doctorId' in request.resource.data) || request.resource.data.doctorId == resource.data.doctorId);

      allow delete: if isSignedIn() && request.auth.uid == userId;
      
      // Pencatatan makanan
      match /food_entries/{entryId=**} {
        allow read, write: if isSignedIn() && request.auth.uid == userId;
      }

      // Riwayat prediksi refluks (DOKTER TIDAK BOLEH MEMBACA)
      match /prediction_history/{historyId=**} {
        allow read, write: if isSignedIn() && request.auth.uid == userId;
      }

      // Konsultasi dokter (Spesifik per pasien)
      match /consultations/{consultationId} {
        // Pasien pemilik dapat membaca semua status, dan admin dapat membaca untuk pemantauan penilaian
        allow read: if isSignedIn() && (request.auth.uid == userId || isAdmin());

        // Pasien membuat konsultasi baru
        allow create: if isSignedIn() && request.auth.uid == userId;

        // Pasien update: pasien TIDAK BOLEH menandai status completed (hanya dokter yang berwenang)
        // Pasien boleh mengubah hiddenByPatient, lastReadByPatientAt, chatExpired, dsb.
        // Aturan Rating (Revisi 11 Bagian A & C): Pasien pemilik HANYA boleh mengisi rating jika status completed,
        // rating belum pernah diisi, nilai integer 1..5, dan operasi rating hanya mengubah 'rating' dan 'ratedAt'.
        allow update: if isSignedIn() && request.auth.uid == userId
                      && (!('status' in request.resource.data.diff(resource.data).affectedKeys()) ||
                          request.resource.data.status != 'completed' ||
                          resource.data.status == 'completed')
                      && (
                        !('rating' in request.resource.data.diff(resource.data).affectedKeys()) ||
                        (
                          resource.data.status == 'completed' &&
                          !('rating' in resource.data) &&
                          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['rating', 'ratedAt']) &&
                          request.resource.data.rating is int &&
                          request.resource.data.rating >= 1 &&
                          request.resource.data.rating <= 5
                        )
                      );

        // Penghapusan fisik konsultasi diizinkan jika sudah melewati batas retensi 60 hari
        allow delete: if isSignedIn() && (
          request.auth.uid == userId ||
          (isDoctorForDoc(resource.data) && isOlderThan60Days(resource.data))
        );

        // Dokter dapat membaca konsultasi yang ditujukan kepadanya
        allow read: if isDoctorForDoc(resource.data);

        // Dokter hanya boleh update field-field status dan pesan tertentu,
        // dengan pembatasan transisi status: waiting -> active (konfirmasi) atau active -> completed / waiting -> completed (selesai).
        // Mendukung penulisan completedAt, doctorRecommendation, lastMessageId, chatExpired,
        // serta soft-hide dokter: hiddenByDoctor dan hiddenByDoctorAt (Revisi 11 Bagian B & C)
        // dan lastMessageIsAutoReply (Revisi 12).
        allow update: if isDoctorForDoc(resource.data)
                      && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
                           'status', 'doctorConfirmedAt', 'lastMessageText', 
                           'lastMessageAt', 'lastMessageSenderType', 
                           'unreadForDoctor', 'unreadForPatient', 'lastReadByDoctorAt',
                           'completedAt', 'doctorRecommendation', 'lastMessageId', 'chatExpired',
                           'hiddenByDoctor', 'hiddenByDoctorAt', 'lastMessageIsAutoReply'
                         ])
                      && (
                        !('status' in request.resource.data.diff(resource.data).affectedKeys()) ||
                        (!('status' in resource.data) && request.resource.data.status == 'completed') ||
                        (resource.data.status == 'waiting' && request.resource.data.status == 'active') ||
                        (resource.data.status == 'active' && request.resource.data.status == 'completed') ||
                        (resource.data.status == 'waiting' && request.resource.data.status == 'completed')
                      );

        // Sub-koleksi pesan chat
        match /messages/{messageId} {
          // Pasien pemilik dapat membaca pesan
          allow read: if isSignedIn() && request.auth.uid == userId;

          // Pasien pemilik dapat membuat pesan baru miliknya (senderType == 'patient'),
          // ATAU balasan perkenalan dokter otomatis HANYA jika isAutoReply == true
          // dan consultation.autoReplySent berubah dari belum ada/false menjadi true (Revisi 12 Bagian A & C)
          allow create: if isSignedIn() && request.auth.uid == userId
                        && (
                          request.resource.data.senderType == 'patient' ||
                          (
                            request.resource.data.senderType == 'doctor'
                            && ('isAutoReply' in request.resource.data)
                            && request.resource.data.isAutoReply == true
                            && (
                              !('autoReplySent' in get(/databases/$(database)/documents/users/$(userId)/consultations/$(consultationId)).data) ||
                              get(/databases/$(database)/documents/users/$(userId)/consultations/$(consultationId)).data.autoReplySent != true
                            )
                            && getAfter(/databases/$(database)/documents/users/$(userId)/consultations/$(consultationId)).data.autoReplySent == true
                          )
                        );

          // Dokter terkait dapat membaca pesan
          allow read: if isDoctorForDoc(get(/databases/$(database)/documents/users/$(userId)/consultations/$(consultationId)).data);

          // Dokter dapat membuat pesan jika konsultasi valid dan senderType adalah 'doctor'
          allow create: if isDoctorForDoc(get(/databases/$(database)/documents/users/$(userId)/consultations/$(consultationId)).data)
                        && (
                          !('paymentStatus' in get(/databases/$(database)/documents/users/$(userId)/consultations/$(consultationId)).data) ||
                          get(/databases/$(database)/documents/users/$(userId)/consultations/$(consultationId)).data.paymentStatus == 'paid' ||
                          request.resource.data.type == 'consultation_summary'
                        )
                        && request.resource.data.senderType == 'doctor';

          // Update pesan oleh Pasien pemilik (Bagian C & E):
          // Pesan ringkasan dokter (type == 'consultation_summary') tidak boleh diubah.
          // Pasien hanya boleh:
          // (i) Sembunyikan untuk saya: hanya field 'hiddenFor' yang diubah.
          // (ii) Edit atau hapus untuk semua pada pesan miliknya (senderType == 'patient'):
          //      hanya field text, editedAt, deletedForEveryone, deletedAt, dan data lampiran.
          allow update: if isSignedIn() && request.auth.uid == userId
                        && (!('type' in resource.data) || resource.data.type != 'consultation_summary')
                        && (
                          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['hiddenFor']) ||
                          (
                            resource.data.senderType == 'patient'
                            && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
                                 'text', 'editedAt', 'deletedForEveryone', 'deletedAt',
                                 'attachmentUrl', 'attachmentId', 'fileName', 'fileSize', 'sizeBytes', 'mimeType'
                               ])
                            && request.resource.data.senderType == resource.data.senderType
                          )
                        );

          // Update pesan oleh Dokter terkait (Bagian C & E):
          // Pesan ringkasan dokter (type == 'consultation_summary') tidak boleh diubah.
          // Dokter hanya boleh:
          // (i) Sembunyikan untuk saya: hanya field 'hiddenFor' yang diubah.
          // (ii) Edit atau hapus untuk semua pada pesan dokter miliknya (senderType == 'doctor'):
          //      hanya field text, editedAt, deletedForEveryone, deletedAt, dan data lampiran.
          allow update: if isDoctorForDoc(get(/databases/$(database)/documents/users/$(userId)/consultations/$(consultationId)).data)
                        && (!('type' in resource.data) || resource.data.type != 'consultation_summary')
                        && (
                          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['hiddenFor']) ||
                          (
                            resource.data.senderType == 'doctor'
                            && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
                                 'text', 'editedAt', 'deletedForEveryone', 'deletedAt',
                                 'attachmentUrl', 'attachmentId', 'fileName', 'fileSize', 'sizeBytes', 'mimeType'
                               ])
                            && request.resource.data.senderType == resource.data.senderType
                          )
                        );

          // Hard delete pesan dari klien HANYA diizinkan oleh peserta jika sudah melewati batas retensi 60 hari (Bagian D & E)
          allow delete: if isSignedIn() && (
            (request.auth.uid == userId || isDoctorForDoc(get(/databases/$(database)/documents/users/$(userId)/consultations/$(consultationId)).data))
            && isOlderThan60Days(get(/databases/$(database)/documents/users/$(userId)/consultations/$(consultationId)).data)
          );
        }

        // ── Sub-koleksi Lampiran Berkas/PDF di Firestore (Revisi 12 Bagian B & C) ──
        // Menyimpan binary berkas sebagai base64 terpisah dari dokumen pesan
        match /attachments/{attachmentId} {
          // Pasien pemilik dan dokter yang ditunjuk dapat membaca pada semua status
          allow read: if isSignedIn() && (
            request.auth.uid == userId ||
            isDoctorForDoc(get(/databases/$(database)/documents/users/$(userId)/consultations/$(consultationId)).data)
          );

          // Create hanya diizinkan oleh pengirim saat konsultasi waiting atau active,
          // dengan validasi ketat field keys dan batas ukuran berkas < 1 MiB (1.048.576 bytes)
          allow create: if isSignedIn() && (
            (
              request.auth.uid == userId &&
              request.resource.data.senderType == 'patient'
            ) ||
            (
              isDoctorForDoc(get(/databases/$(database)/documents/users/$(userId)/consultations/$(consultationId)).data) &&
              request.resource.data.senderType == 'doctor'
            )
          )
          && (
            get(/databases/$(database)/documents/users/$(userId)/consultations/$(consultationId)).data.status in ['waiting', 'active']
          )
          && request.resource.data.keys().hasOnly(['data', 'fileName', 'mimeType', 'sizeBytes', 'senderType', 'createdAt'])
          && request.resource.data.data is string
          && request.resource.data.data.size() < 1048576;

          // Update oleh pengirim HANYA untuk mengosongkan data berkas (fitur hapus untuk semua orang)
          allow update: if isSignedIn() && (
            (
              request.auth.uid == userId &&
              resource.data.senderType == 'patient'
            ) ||
            (
              isDoctorForDoc(get(/databases/$(database)/documents/users/$(userId)/consultations/$(consultationId)).data) &&
              resource.data.senderType == 'doctor'
            )
          )
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['data'])
          && (request.resource.data.data == '' || !('data' in request.resource.data));

          // Delete fisik dokumen lampiran hanya lewat batas retensi 60 hari
          allow delete: if isSignedIn() && (
            (request.auth.uid == userId || isDoctorForDoc(get(/databases/$(database)/documents/users/$(userId)/consultations/$(consultationId)).data))
            && isOlderThan60Days(get(/databases/$(database)/documents/users/$(userId)/consultations/$(consultationId)).data)
          );
        }
      }
    }

    // ── 2. Collection Group Query Konsultasi ────────────────────────────────
    // Diperlukan agar dokter dapat melakukan query: collectionGroup('consultations').where('doctorId', '==', myDoctorId())
    // serta admin untuk memantau penilaian konsultasi dokter (read-only).
    match /{path=**}/consultations/{consultationId} {
      allow read: if isDoctorForDoc(resource.data) || isAdmin();
    }
    
    // ── 3. Riwayat Login (Root level collection) ───────────────────────────
    match /login_history/{docId} {
      allow read, update, delete: if isSignedIn() 
                               && resource.data.user_id == request.auth.uid;
                               
      allow create: if isSignedIn() 
                 && request.resource.data.user_id == request.auth.uid;
    }

    // ── 4. Koleksi Artikel Berita ────────────────────────────────────────────
    // Path: /berita_articles/{articleId}
    match /berita_articles/{articleId} {
      // Artikel berita dapat dibaca publik (baik user login maupun pengguna umum/tamu)
      allow read: if true;
      // Hanya admin yang berhak menambah, mengubah, atau menghapus artikel berita
      allow create, update, delete: if isAdmin();
    }

    // ── 4b. Metadata Sistem (Penanda Seeding Berita, dsb.) ───────────────────
    // Path: /meta/{metaId}
    match /meta/{metaId} {
      // Status penanda seeding dapat dibaca publik
      allow read: if true;
      // Hanya admin yang berhak menulis/memperbarui penanda seeding
      allow write: if isAdmin();
    }

    // ── 5. Koleksi Ensiklopedia (Gastropedia) ──────────────────────────────
    // Path: /encyclopedia/{docId}
    match /encyclopedia/{docId} {
      // Admin dapat membaca semua entri (termasuk draft). Pengguna hanya membaca entri berstatus 'terbit'
      allow read: if isAdmin() || (isSignedIn() && (!('status' in resource.data) || resource.data.status == 'terbit'));
      allow write: if isAdmin();
    }

    // ── 6. Koleksi Berita (legacy, tidak dipakai lagi – biarkan read saja) ──
    match /berita/{docId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // ── 7. Log Aktivitas (dipakai oleh admin) ────────────────────────────────
    match /activity_log/{logId} {
      allow read, create: if isAdmin();
      allow update, delete: if false;
    }

    // ── 8. Koleksi Dokter & Jadwal Praktik ─────────────────────────────────
    // Path: /doctors/{doctorId}
    match /doctors/{doctorId} {
      // Semua user yang sudah login bisa membaca data dokter
      allow read: if isSignedIn();

      // Update dokter:
      // 1. Admin memiliki hak update penuh.
      // 2. Dokter hanya dapat mengupdate profil dirinya sendiri dan field tertentu saja.
      // 3. Pasien login dapat memperbarui agregat rating (ratingSum dan ratingCount) saat memberi penilaian,
      //    dengan validasi ketat: affectedKeys hanya ratingSum dan ratingCount, ratingCount bertambah tepat 1,
      //    dan ratingSum bertambah antara 1 sampai 5 (Revisi 11 Bagian A & C).
      allow update: if (isAdmin()) ||
                    (
                      isDoctor() 
                      && (
                        (myDoctorId() != '' && myDoctorId() == doctorId) ||
                        (doctorId == request.auth.uid) ||
                        (('uid' in resource.data) && resource.data.uid == request.auth.uid)
                      )
                      && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
                           'name', 'strNumber', 'gender', 'updatedAt', 'photoUrl',
                           'photoBase64', 'photoUpdatedAt', 'consultationsHandled', 'experienceYears', 'autoReplyEnabled'
                         ])
                    ) ||
                    (
                      isSignedIn()
                      && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['ratingSum', 'ratingCount'])
                      && request.resource.data.ratingCount is int
                      && request.resource.data.ratingSum is int
                      && request.resource.data.ratingCount == (('ratingCount' in resource.data ? resource.data.ratingCount : 0) + 1)
                      && request.resource.data.ratingSum >= (('ratingSum' in resource.data ? resource.data.ratingSum : 0) + 1)
                      && request.resource.data.ratingSum <= (('ratingSum' in resource.data ? resource.data.ratingSum : 0) + 5)
                    );

      allow create, delete: if false;

      // Sub-koleksi jadwal praktik: /doctors/{doctorId}/schedule/{date}
      match /schedule/{date} {
        allow read: if isSignedIn();
        allow write: if isDoctor() && myDoctorId() == doctorId;
      }
    }

    // ── 9. Koleksi Penilaian Gastropedia ───────────────────────────────────
    // Path: /gastropedia_ratings/{ratingId}
    // Pengguna hanya dapat membaca & menyimpan penilaian miliknya sendiri.
    // Admin dapat membaca seluruh penilaian untuk pemantauan (read-only).
    match /gastropedia_ratings/{ratingId} {
      allow read: if isSignedIn() && (
        isAdmin() ||
        resource.data.userId == request.auth.uid
      );

      allow create, update: if isSignedIn() &&
        request.resource.data.userId == request.auth.uid &&
        request.resource.data.rating is int &&
        request.resource.data.rating >= 1 &&
        request.resource.data.rating <= 5;

      allow delete: if false;
    }
  }
}
