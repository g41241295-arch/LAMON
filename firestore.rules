rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // ── Helper Functions ───────────────────────────────────────────────────
    function isSignedIn() {
      return request.auth != null;
    }

    function userDoc() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isDoctor() {
      return isSignedIn() && 
             ('role' in userDoc()) && 
             (userDoc().role == 'doctor' || userDoc().role == 'dokter');
    }

    function myDoctorId() {
      return (isDoctor() && ('doctorId' in userDoc())) ? userDoc().doctorId : '';
    }

    // ── 1. Users Collection & Sub-collections ──────────────────────────────
    // Path: /users/{userId}
    match /users/{userId} {
      // Pemilik akun bisa membaca data dirinya
      allow read: if isSignedIn() && request.auth.uid == userId;

      // Pembuatan user baru (register publik): role tidak boleh langsung di-set ke 'doctor' / 'dokter'
      allow create: if isSignedIn() && request.auth.uid == userId 
                    && (!('role' in request.resource.data) || request.resource.data.role == 'patient' || request.resource.data.role == 'pengguna')
                    && (!('doctorId' in request.resource.data));

      // Update profil: role dan doctorId TIDAK BOLEH diubah dari sisi klien (mencegah eskalasi hak akses)
      allow update: if isSignedIn() && request.auth.uid == userId
                    && (!('role' in request.resource.data) || request.resource.data.role == resource.data.role)
                    && (!('doctorId' in request.resource.data) || request.resource.data.doctorId == resource.data.doctorId);

      allow delete: if isSignedIn() && request.auth.uid == userId;
      
      // Pencatatan makanan
      match /food_entries/{entryId} {
        allow read, update, delete: if isSignedIn() 
                                 && request.auth.uid == userId 
                                 && resource.data.user_id == request.auth.uid;
                                 
        allow create: if isSignedIn() 
                   && request.auth.uid == userId 
                   && request.resource.data.user_id == request.auth.uid;
      }

      // Riwayat prediksi refluks (DOKTER TIDAK BOLEH MEMBACA)
      match /prediction_history/{historyId=**} {
        allow read, write: if isSignedIn() && request.auth.uid == userId;
      }

      // Konsultasi dokter (Spesifik per pasien)
      match /consultations/{consultationId} {
        // Pasien pemilik dapat membaca dan menulis
        allow read, write: if isSignedIn() && request.auth.uid == userId;

        // Dokter dapat membaca konsultasi yang ditujukan kepadanya
        allow read: if isDoctor() && resource.data.doctorId == myDoctorId();

        // Dokter hanya boleh update field-field status dan pesan tertentu
        allow update: if isDoctor() 
                      && resource.data.doctorId == myDoctorId()
                      && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
                           'status', 'doctorConfirmedAt', 'lastMessageText', 
                           'lastMessageAt', 'lastMessageSenderType', 
                           'unreadForDoctor', 'unreadForPatient', 'lastReadByDoctorAt'
                         ]);

        // Sub-koleksi pesan chat
        match /messages/{messageId} {
          // Pasien pemilik
          allow read, write: if isSignedIn() && request.auth.uid == userId;

          // Dokter terkait dapat membaca pesan
          allow read: if isDoctor() 
                      && get(/databases/$(database)/documents/users/$(userId)/consultations/$(consultationId)).data.doctorId == myDoctorId();

          // Dokter dapat membuat pesan jika konsultasi sudah paid dan senderType adalah 'doctor'
          allow create: if isDoctor() 
                        && get(/databases/$(database)/documents/users/$(userId)/consultations/$(consultationId)).data.doctorId == myDoctorId()
                        && get(/databases/$(database)/documents/users/$(userId)/consultations/$(consultationId)).data.paymentStatus == 'paid'
                        && request.resource.data.senderType == 'doctor';
        }
      }
    }

    // ── 2. Collection Group Query Konsultasi ────────────────────────────────
    // Diperlukan agar dokter dapat melakukan query: collectionGroup('consultations').where('doctorId', '==', myDoctorId())
    match /{path=**}/consultations/{consultationId} {
      allow read: if isDoctor() && resource.data.doctorId == myDoctorId();
    }
    
    // ── 3. Riwayat Login (Root level collection) ───────────────────────────
    match /login_history/{docId} {
      allow read, update, delete: if isSignedIn() 
                               && resource.data.user_id == request.auth.uid;
                               
      allow create: if isSignedIn() 
                 && request.resource.data.user_id == request.auth.uid;
    }

    // ── 4. Koleksi Dokter & Jadwal Praktik ─────────────────────────────────
    // Path: /doctors/{doctorId}
    match /doctors/{doctorId} {
      // Semua user yang sudah login bisa membaca data dokter
      allow read: if isSignedIn();

      // Dokter hanya dapat mengupdate profil dirinya sendiri dan field tertentu saja
      allow update: if isDoctor() 
                    && myDoctorId() == doctorId 
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
                         'name', 'strNumber', 'gender', 'updatedAt'
                       ]);

      allow create, delete: if false;

      // Sub-koleksi jadwal praktik: /doctors/{doctorId}/schedule/{date}
      match /schedule/{date} {
        allow read: if isSignedIn();
        allow write: if isDoctor() && myDoctorId() == doctorId;
      }
    }
  }
}
