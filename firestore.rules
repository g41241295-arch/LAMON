rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // 1. Rules untuk koleksi user dan pencatatan makanan
    // Path: /users/{userId}/food_entries/{entryId}
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
      
      match /food_entries/{entryId} {
        // Hanya izinkan jika user login, path userId sama dengan uid, 
        // dan payload field "user_id" sama dengan uid (mencegah manipulasi data)
        allow read, update, delete: if request.auth != null 
                                 && request.auth.uid == userId 
                                 && resource.data.user_id == request.auth.uid;
                                 
        allow create: if request.auth != null 
                   && request.auth.uid == userId 
                   && request.resource.data.user_id == request.auth.uid;
      }

      // Rules untuk riwayat prediksi refluks asam lambung (Sub-koleksi users)
      // Path: /users/{userId}/prediction_history/{historyId}
      match /prediction_history/{historyId=**} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }

      // Rules untuk konsultasi dokter (Sub-koleksi users)
      // Path: /users/{userId}/consultations/{consultationId}
      // Hanya pemilik uid yang bisa membaca/menulis, mengikuti pola prediction_history.
      match /consultations/{consultationId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;

        // Sub-koleksi pesan chat per konsultasi
        // Path: /users/{userId}/consultations/{consultationId}/messages/{messageId}
        match /messages/{messageId} {
          allow read, write: if request.auth != null && request.auth.uid == userId;
        }
      }
    }
    
    // 2. Rules untuk riwayat login (Root level collection)
    // Path: /login_history/{docId}
    match /login_history/{docId} {
      allow read, update, delete: if request.auth != null 
                               && resource.data.user_id == request.auth.uid;
                               
      allow create: if request.auth != null 
                 && request.resource.data.user_id == request.auth.uid;
    }

    // 3. Rules untuk koleksi dokter (Root level collection)
    // Path: /doctors/{doctorId}
    // Semua user yang sudah login bisa membaca data dokter.
    // Penulisan/pengeditan data dokter HANYA melalui Firebase Console atau Admin SDK —
    // tidak bisa dilakukan dari client user biasa.
    match /doctors/{doctorId} {
      allow read: if request.auth != null;
      allow write: if false; // Hanya via Firebase Console / Admin SDK
    }
  }
}
